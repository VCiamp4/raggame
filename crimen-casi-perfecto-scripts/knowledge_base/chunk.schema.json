{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raggame.local/schemas/chunk.schema.json",
  "title": "RAGGame knowledge chunk",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "chunk_id",
    "scene_id",
    "source",
    "source_text",
    "retrieval_text",
    "kind",
    "speakers",
    "mentioned_entities",
    "knowledge_holders",
    "claim_status",
    "availability",
    "discovery",
    "retrieval",
    "security"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "chunk_id": {
      "type": "string",
      "pattern": "^SCN-[0-9]{2}-CH-[0-9]{2}$"
    },
    "scene_id": {
      "type": "string",
      "pattern": "^SCN-[0-9]{2}$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonical_file", "canonical_lines", "scene_file"],
      "properties": {
        "canonical_file": {
          "const": "un-crimen-casi-perfecto-version-final.md"
        },
        "canonical_lines": {
          "type": "array",
          "prefixItems": [
            {"type": "integer", "minimum": 1},
            {"type": "integer", "minimum": 1}
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        "scene_file": {
          "type": "string",
          "pattern": "^scenes/[0-9]{2}_[a-z0-9_]+\\.md$"
        }
      }
    },
    "source_text": {
      "type": "string",
      "minLength": 1
    },
    "retrieval_text": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "narration",
        "dialogue",
        "testimony",
        "physical_evidence",
        "forensic_result",
        "investigator_inference",
        "reconstruction",
        "resolution"
      ]
    },
    "speakers": {
      "$ref": "#/$defs/entities"
    },
    "addressees": {
      "$ref": "#/$defs/entities"
    },
    "mentioned_entities": {
      "$ref": "#/$defs/entities"
    },
    "knowledge_holders": {
      "$ref": "#/$defs/entities"
    },
    "claim_status": {
      "enum": ["observation", "testimony", "verified", "inference", "ground_truth"]
    },
    "availability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["milestones_all", "facts_all", "facts_any", "facts_none", "channels"],
      "properties": {
        "milestones_all": {"$ref": "#/$defs/idList"},
        "facts_all": {"$ref": "#/$defs/idList"},
        "facts_any": {"$ref": "#/$defs/idList"},
        "facts_none": {"$ref": "#/$defs/idList"},
        "channels": {
          "type": "array",
          "items": {
            "enum": [
              "chat_criada",
              "chat_portero",
              "chat_juan",
              "chat_esteban",
              "chat_pablo",
              "chat_perito_quimico",
              "chat_tecnico_heladera",
              "inspect_departamento",
              "inspect_poliza",
              "inspect_heladera",
              "inspect_erpa",
              "resolution"
            ]
          },
          "uniqueItems": true
        }
      }
    },
    "discovery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fact_ids", "focus_eligible"],
      "properties": {
        "fact_ids": {"$ref": "#/$defs/idList"},
        "focus_eligible": {"type": "boolean"}
      }
    },
    "retrieval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["keywords", "neighbor_ids", "priority"],
      "properties": {
        "keywords": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "neighbor_ids": {
          "type": "array",
          "items": {"type": "string", "pattern": "^SCN-[0-9]{2}-CH-[0-9]{2}$"},
          "uniqueItems": true
        },
        "priority": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        }
      }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spoiler_level", "resolution_only"],
      "properties": {
        "spoiler_level": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "resolution_only": {
          "type": "boolean"
        }
      }
    }
  },
  "$defs": {
    "idList": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_-]+$"
      },
      "uniqueItems": true
    },
    "entities": {
      "type": "array",
      "items": {
        "enum": [
          "detective",
          "senora_stevens",
          "criada",
          "portero",
          "juan",
          "esteban",
          "pablo",
          "perito_quimico",
          "tecnico_heladera",
          "policia",
          "erpa",
          "departamento",
          "heladera",
          "poliza",
          "vaso_whisky"
        ]
      },
      "uniqueItems": true
    }
  }
}
