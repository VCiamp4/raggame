[sub_resource type="Shader" id="Shader_tablaBackdrop"]
code = "shader_type spatial;
render_mode unshaded, cull_disabled;
uniform vec4 color_top : source_color = vec4(0.1098, 0.098, 0.184, 1.0);
uniform vec4 color_bottom : source_color = vec4(0.3686, 0.2274, 0.1803, 1.0);
uniform float grid_scale = 6.0;
uniform float grid_intensity = 0.08;

vec3 grid_lines(vec2 uv){
	vec2 g = abs(fract(uv * grid_scale) - 0.5);
	float line = smoothstep(0.48, 0.5, 0.5 - min(g.x, g.y));
	return vec3(line);
}

void fragment(){
	vec4 base = mix(color_bottom, color_top, UV.y);
	vec3 grid = grid_lines(UV);
	vec3 color = base.rgb + grid * grid_intensity;
	ALBEDO = color;
	EMISSION = color * 0.15;
	ALPHA = base.a;
}
"

