OLLAMA_CHAT_BASE_URL=http://127.0.0.1:11434
OLLAMA_EMBED_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:e4b
# El runtime de retrieval solo admite la familia embeddinggemma:
OLLAMA_EMBED_MODEL=hf.co/unsloth/embeddinggemma-300m-GGUF:Q4_0
OLLAMA_KEEP_ALIVE=30m
OLLAMA_EMBED_KEEP_ALIVE=30m
OLLAMA_NUM_CTX=1536
OLLAMA_NUM_PREDICT=160
OLLAMA_TEMPERATURE=0.35
OLLAMA_TOP_P=0.9
# 0 conserva todo el historial; un valor positivo limita la cantidad de mensajes.
OLLAMA_MAX_HISTORY=0
OLLAMA_REQUEST_TIMEOUT=600
RAG_DENSE_CANDIDATES=8
RAG_SUPPORT_CHUNKS=2
# Umbral raw por chunk seleccionado, sin refill; calibrado para embeddinggemma.
RAG_MIN_DENSE_SIMILARITY=0.50
# Índice embeddinggemma construido con q1 + q2:
RAG_INDEX_PATH=backend/data/rag_index_atomic_embeddinggemma_two.sqlite3
RAG_CANONICAL_QUESTIONS_TWO_PATH=backend/data/canonical_questions_two.json
